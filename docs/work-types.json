{
  "openapi": "3.1.1",
  "info": {
    "title": "Hang Nadim SIK RESTful API - Work Types",
    "version": "1.0",
    "description": "OpenAPI doc for work-types endpoints",
    "contact": { "email": "luckyabdillah00@gmail.com" }
  },
  "servers": [
    { "url": "https://sik.luckyabdillah.com/api/v1" },
    { "url": "http://127.0.0.1:8000/api/v1" }
  ],
  "paths": {
    "/work-types": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["WorkType"],
        "summary": "Get all work types",
        "responses": {
          "200": {
            "description": "Success get all work types",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": { "type": "number" },
                    "message": { "type": "string" },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "integer" },
                          "type": { "type": "string" },
                          "unit_name": { "type": "string" },
                          "provision_text_before": { "type": "string" },
                          "provision_text_after": { "type": "string" },
                          "created_at": { "type": "string" },
                          "updated_at": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["WorkType"],
        "summary": "Create new work type",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "unit_name"],
                "properties": {
                  "type": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "unit_name": { "type": "string", "minLength": 1, "maxLength": 100 },
                  "provision_text_before": { "type": "string" },
                  "provision_text_after": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success create work type",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          }
        }
      }
    },
    "/work-types/{id}": {
      "get": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["WorkType"],
        "summary": "Get work type by id",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "OK" },
          "404": { "description": "Not found" }
        }
      },
      "put": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["WorkType"],
        "summary": "Update work type",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["type", "unit_name"],
                "properties": {
                  "type": { "type": "string" },
                  "unit_name": { "type": "string" },
                  "provision_text_before": { "type": "string" },
                  "provision_text_after": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "OK" }, "404": { "description": "Not found" }, "422": { "description": "Validation failed" } }
      },
      "delete": {
        "security": [{ "BearerAuth": [] }],
        "tags": ["WorkType"],
        "summary": "Delete work type",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": { "200": { "description": "OK" }, "404": { "description": "Not found" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "BearerAuth": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" } }
  }
}
